# Server
PORT=5000

# MongoDB Atlas connection string
# MongoDB Atlas Dashboard -> Database -> Connect -> Drivers -> copy the connection string
# Example: mongodb+srv://myuser:mypassword@cluster0.xxxxx.mongodb.net/job_portal?retryWrites=true&w=majority
MONGODB_URI=your_mongodb_connection_string_here

# JWT
JWT_SECRET=change_this_to_a_long_random_secret_string

# Email (Gmail example)
# 1. Turn on 2-Step Verification on your Google account
# 2. Create an "App Password" at https://myaccount.google.com/apppasswords
# 3. Use that 16-character app password below (NOT your normal gmail password)
EMAIL_USER=youremail@gmail.com
EMAIL_PASS=your_16_char_app_password

# Hashing Security (For HMAC-SHA256 signatures)
HASH_SECRET=your_64_character_hex_hash_secret_string_here

# Frontend Application Url
FRONTEND_URL=http://localhost:5173

# Cloudinary Configuration (For cloud uploads of resumes and images)
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here

